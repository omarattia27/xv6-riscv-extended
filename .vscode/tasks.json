{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "launch-qemu-gdb",
      "type": "shell",
      "command": "make qemu-gdb",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Now run 'gdb' in another window."
          }
        }
      ]
    }
  ]
}
