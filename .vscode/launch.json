{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xv6-riscv Debug",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/kernel/kernel",
      "target": "localhost:25501",
      "remote": true,
      "cwd": "${workspaceFolder}",
      "gdbpath": "/Users/omarattia/riscv-toolchain/bin/riscv-none-elf-gdb",
      "autorun": [
        "set architecture riscv:rv64"
      ]
    }
  ]
}
// to rebuild: make clean && make qemu-gdb
// start with: make qemu-gdb
